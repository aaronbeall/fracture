{
  "manifest_version": 3,
  "name": "Fracture Anything",
  "version": "0.0.0",
  "description": "Shatter any web page into slow-motion 3D shards. Click the toolbar button, then click things. Escape restores the page.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Fracture this page",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fracture this page"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "fracture-anything@abeall.com" }
  }
}
