{
  "name": "@abeall/fracture",
  "version": "0.1.0",
  "description": "Shatter DOM elements into slow-motion 3D shards with depth-of-field blur. Pure fracture algorithm, element API, React hooks, an easter egg, and a fracture-any-page extension.",
  "keywords": [
    "fracture",
    "shatter",
    "break",
    "glass",
    "shards",
    "dom",
    "webgl",
    "three",
    "animation",
    "effect",
    "react",
    "easter-egg",
    "bookmarklet"
  ],
  "author": "Aaron Beall",
  "license": "MIT",
  "homepage": "https://aaronbeall.github.io/fracture/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronbeall/fracture.git"
  },
  "bugs": {
    "url": "https://github.com/aaronbeall/fracture/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/fracture-anywhere.js"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./algorithm": {
      "types": "./dist/algorithm.d.ts",
      "import": "./dist/algorithm.js"
    },
    "./easter-egg": {
      "types": "./dist/easter-egg.d.ts",
      "import": "./dist/easter-egg.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite -c vite.site.config.ts --host 127.0.0.1 --port 4179",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && vite build -c vite.anywhere.config.ts && tsc -p tsconfig.build.json",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "prepack": "npm run build",
    "build:site": "npm run build:extension && vite build -c vite.site.config.ts && node scripts/build-site.mjs",
    "preview:site": "vite preview -c vite.site.config.ts --host 127.0.0.1 --port 4180",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "three": "^0.180.0"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@types/node": "^22.15.21",
    "@testing-library/react": "^16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.18",
    "@testing-library/dom": "^10.4.1"
  }
}
