{
  "name": "@aaronbeall/fracture",
  "version": "0.1.0",
  "description": "A transparent WebGL DOM fracture effect with radial shards and depth blur.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tuning": {
      "types": "./dist/tuning.d.ts",
      "import": "./dist/tuning.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4179",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && vite build -c vite.anywhere.config.ts && tsc -p tsconfig.build.json",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "three": "^0.180.0"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@types/node": "^22.15.21",
    "@testing-library/react": "^16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.18",
    "@testing-library/dom": "^10.4.1"
  }
}
